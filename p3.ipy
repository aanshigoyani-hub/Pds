# if
age = 20
if age >= 18:
    print("You are eligible to vote")

# if else
num = 4
if num % 2 == 0:
    print("Even number")
else:
    print("Odd number")

# elif
marks = 75
if marks >= 80:
    print("Grade A")
elif marks < 80 and marks >= 60:
    print("Grade B")
elif marks < 60 and marks >= 33:
    print("Grade C")
else:
    print("Fail")

# while
i = 1
while i <= 5:
    print(i)
    i += 1

# for
for i in range(6):
    print(i)

# nested for
for i in range(2):
    for j in range(3):
        print(i, j)

# break
for i in range(6):
    if i == 3:
        break
    print(i)

# continue
for i in range(6):
    if i == 3:
        continue
    print(i)

# pass
for i in range(6):
    if i == 2:
        pass
    print(i)
