# pyright: reportMissingModuleSource=false
# Install pandas in the notebook environment if needed: %pip install pandas
import pandas as pd

# Create Series
marks = pd.Series([85, 72, 90, 65, 78])
print("Series: ", marks)

# Create DataFrame
data = {
    "Name": ["pal", "Aarya", "Nancy", "Zeel", "Ruchita", "Pari"],
    "Department": ["Computer", "IT", "Computer", "IT", "Computer", "IT"],
    "Marks": [85, 72, 90, 65, 78, 88],
    "Age": [20, 21, 22, 21, 20, 20],
}
df = pd.DataFrame(data)
print("Dataframe: ", df)

# select
print("Select name and marks column:\n", df[["Name", "Marks"]])
print("Select first two rows:\n", df.iloc[:2])
print("Marks of index 2:", df.loc[2, "Marks"])

# filter
print(
    "Student with marks greater than 80 and age 20:\n",
    df[(df["Marks"] > 80) & (df["Age"] == 20)],
)
print("Student from IT department:\n", df[df["Department"] == "IT"])

# grouping and agreegation
print("Group by departments of Student:")
grouped = df.groupby("Department")
print(grouped["Marks"].mean())

print("Average Marks: ", df["Marks"].mean())
print("Maximum age: ", df["Age"].max())
print("Minimum age: ", df["Age"].min())
print("Total Marks: ", df["Marks"].sum())
print("Multiple aggregation:")
print(df.groupby("Department")["Marks"].agg(["mean", "sum"]))
